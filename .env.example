# Finzaro V0.0.3 — Account Core
# Copy to .env.local only when running Next.js locally.
# Never commit .env.local, secret keys, database passwords, or access tokens.

NEXT_PUBLIC_FINZARO_ENV=development

# Public app URL. On Vercel production, set this to your deployed Finzaro URL.
# Example: https://finzaro.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase DEV values from Project > Connect.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional convenience variable for CLI/docs only. Not used by browser code.
SUPABASE_PROJECT_REF=YOUR_DEV_PROJECT_REF
